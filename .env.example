# Server
ODYSSEUS_API_HOST=127.0.0.1
ODYSSEUS_API_PORT=8787
ODYSSEUS_CONSOLE_PASSWORD=changeme

# LLM bridge / backend selection
ODYSSEUS_LLM=bridge  # bridge | openai
ODYSSEUS_CODEX_URL=http://localhost:3000/api/codex
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# Providers (mock defaults)
EMAIL_PROVIDER=mock
CALENDAR_PROVIDER=mock

# Planner
ODYSSEUS_MAX_STEPS=8
ODYSSEUS_TEMPERATURE=0.2

# SQLite db
ODYSSEUS_DB=./odysseus.db

# === Integrations (optional; mocks used if unset) ===
GMAIL_PROVIDER=mock
GMAIL_USER=you@example.com
GOOGLE_CREDENTIALS_JSON=./google.credentials.json
SLACK_PROVIDER=mock
SLACK_BOT_TOKEN=xoxb-...
NOTION_PROVIDER=mock
NOTION_API_TOKEN=secret_...
NOTION_DEFAULT_DB=...
